<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:colorPrimary">#FF1C1C1E</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:popupMenuStyle">@style/AppPopup</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <!-- Menus: readable text, comfortable but not oversized rows -->
        <item name="android:textAppearanceLargePopupMenu">@style/AppMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/AppMenuText</item>
        <item name="android:listPreferredItemHeightSmall">44dp</item>
        <item name="android:listPreferredItemPaddingLeft">18dp</item>
        <item name="android:listPreferredItemPaddingRight">18dp</item>
    </style>

    <style name="AppPopup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="AppMenuText" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFF2F2F7</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <!-- Dialog windows: no system grow-in (the app does its own), and a quick fade-out -->
    <style name="ZenDialogAnim">
        <item name="android:windowEnterAnimation">@anim/zen_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/zen_dialog_exit</item>
    </style>

    <style name="AppDialogTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFF2F2F7</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
