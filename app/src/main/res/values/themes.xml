<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:colorPrimary">#FF1C1C1E</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:popupMenuStyle">@style/AppPopup</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppPopup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF0A84FF</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
